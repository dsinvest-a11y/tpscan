//@version=6
// TP Fable Scanner — qualified zone overlay (build v57.3, run )
// Generated by the zone audit. Paste once into the Pine editor, save,
// add to chart: the correct zones appear per ticker automatically.
// Fill = timeframe: Monthly orange / Weekly yellow / Daily blue.
// Border = zone kind: green Demand / red Supply.
// Label: frame · core score/20 · P:purity subscore.
indicator("TP Fable Zones v57.3", overlay = true, max_boxes_count = 500)

f_z(_top, _bot, _left, _col, _transp, _kind_col, _txt, _valign) =>
    box.new(left = _left, right = time, top = _top, bottom = _bot,
         xloc = xloc.bar_time, extend = extend.right,
         border_color = _kind_col, border_width = 2,
         bgcolor = color.new(_col, _transp),
         text = _txt, text_color = _col, text_size = size.small,
         text_halign = text.align_right, text_valign = _valign)

var bool _drawn = false
if barstate.islast and not _drawn
    _drawn := true
    if syminfo.ticker == "QQQ"
        f_z(322.5600, 309.8900, timestamp(2023, 4, 3), color.rgb(249, 115, 22), 90, color.rgb(47, 191, 113), "M · Demand · 20/20 · P:4", text.align_bottom)
        f_z(389.9400, 385.8200, timestamp(2023, 11, 20), color.rgb(250, 204, 21), 87, color.rgb(47, 191, 113), "W · Demand · 20/20 · P:4", text.align_bottom)
        f_z(530.5000, 524.8800, timestamp(2025, 6, 9), color.rgb(250, 204, 21), 87, color.rgb(47, 191, 113), "W · Demand · 19/20 · P:4", text.align_bottom)
        f_z(487.9700, 476.7820, timestamp(2025, 5, 5), color.rgb(250, 204, 21), 87, color.rgb(47, 191, 113), "W · Demand · 19/20 · P:4", text.align_bottom)
    if syminfo.ticker == "QQQ"
        f_z(674.6600, 668.9000, timestamp(2026, 5, 4), color.rgb(59, 130, 246), 84, color.rgb(47, 191, 113), "D · Demand · 19/20 · P:4", text.align_bottom)
        f_z(657.5500, 653.8100, timestamp(2026, 4, 28), color.rgb(59, 130, 246), 84, color.rgb(47, 191, 113), "D · Demand · 19/20 · P:4", text.align_bottom)
        f_z(707.6800, 705.4251, timestamp("GMT", 2026, 7, 22, 18, 30), color.rgb(34, 211, 238), 82, color.rgb(229, 72, 77), "H4 · Supply · 19/20 · P:4", text.align_top)
        f_z(709.8900, 706.6900, timestamp("GMT", 2026, 7, 21, 18, 30), color.rgb(34, 211, 238), 82, color.rgb(229, 72, 77), "H4 · Supply · 19/20 · P:4", text.align_top)
    if syminfo.ticker == "QQQ"
        f_z(707.6800, 707.1201, timestamp("GMT", 2026, 7, 22, 18, 30), color.rgb(167, 139, 250), 80, color.rgb(229, 72, 77), "H1 · Supply · 20/20 · P:4", text.align_top)
        f_z(696.0000, 695.1500, timestamp("GMT", 2026, 7, 23, 20, 30), color.rgb(167, 139, 250), 80, color.rgb(229, 72, 77), "H1 · Supply · 19/20 · P:4", text.align_top)
        f_z(685.0000, 684.7100, timestamp("GMT", 2026, 7, 24, 20, 30), color.rgb(244, 114, 182), 78, color.rgb(229, 72, 77), "M30 · Supply · 19/20 · P:4", text.align_top)
        f_z(689.9900, 689.3800, timestamp("GMT", 2026, 7, 24, 17, 0), color.rgb(244, 114, 182), 78, color.rgb(229, 72, 77), "M30 · Supply · 19/20 · P:4", text.align_top)
