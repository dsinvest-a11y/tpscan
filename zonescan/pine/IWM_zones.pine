//@version=6
// TP Fable Scanner — qualified zone overlay (build v57.3, run )
// Generated by the zone audit. Paste once into the Pine editor, save,
// add to chart: the correct zones appear per ticker automatically.
// Fill = timeframe: Monthly orange / Weekly yellow / Daily blue.
// Border = zone kind: green Demand / red Supply.
// Label: frame · core score/20 · P:purity subscore.
indicator("TP Fable Zones v57.3", overlay = true, max_boxes_count = 500)

f_z(_top, _bot, _left, _col, _transp, _kind_col, _txt, _valign) =>
    box.new(left = _left, right = time, top = _top, bottom = _bot,
         xloc = xloc.bar_time, extend = extend.right,
         border_color = _kind_col, border_width = 2,
         bgcolor = color.new(_col, _transp),
         text = _txt, text_color = _col, text_size = size.small,
         text_halign = text.align_right, text_valign = _valign)

var bool _drawn = false
if barstate.islast and not _drawn
    _drawn := true
    if syminfo.ticker == "IWM"
        f_z(219.3900, 214.1499, timestamp(2025, 7, 1), color.rgb(249, 115, 22), 90, color.rgb(47, 191, 113), "M · Demand · 19/20 · P:4", text.align_bottom)
        f_z(210.4800, 207.7800, timestamp(2025, 6, 16), color.rgb(250, 204, 21), 87, color.rgb(47, 191, 113), "W · Demand · 19/20 · P:4", text.align_bottom)
        f_z(238.5100, 235.4200, timestamp(2025, 9, 8), color.rgb(250, 204, 21), 87, color.rgb(47, 191, 113), "W · Demand · 16/20 · P:0", text.align_bottom)
        f_z(235.1700, 232.3600, timestamp(2025, 8, 25), color.rgb(250, 204, 21), 87, color.rgb(47, 191, 113), "W · Demand · 16/20 · P:0", text.align_bottom)
    if syminfo.ticker == "IWM"
        f_z(269.9500, 267.5900, timestamp(2026, 4, 15), color.rgb(59, 130, 246), 84, color.rgb(47, 191, 113), "D · Demand · 19/20 · P:4", text.align_bottom)
        f_z(262.4000, 260.3400, timestamp(2026, 4, 10), color.rgb(59, 130, 246), 84, color.rgb(47, 191, 113), "D · Demand · 19/20 · P:4", text.align_bottom)
        f_z(296.7500, 296.1200, timestamp("GMT", 2026, 7, 21, 18, 30), color.rgb(34, 211, 238), 82, color.rgb(229, 72, 77), "H4 · Supply · 20/20 · P:4", text.align_top)
        f_z(300.4100, 299.0500, timestamp("GMT", 2026, 7, 6, 14, 30), color.rgb(34, 211, 238), 82, color.rgb(229, 72, 77), "H4 · Supply · 20/20 · P:4", text.align_top)
    if syminfo.ticker == "IWM"
        f_z(295.0500, 294.8150, timestamp("GMT", 2026, 7, 22, 15, 30), color.rgb(167, 139, 250), 80, color.rgb(229, 72, 77), "H1 · Supply · 19/20 · P:4", text.align_top)
        f_z(294.2500, 293.7850, timestamp("GMT", 2026, 7, 22, 19, 30), color.rgb(167, 139, 250), 80, color.rgb(229, 72, 77), "H1 · Supply · 18/20 · P:2", text.align_top)
        f_z(294.2500, 294.1500, timestamp("GMT", 2026, 7, 22, 20, 30), color.rgb(244, 114, 182), 78, color.rgb(229, 72, 77), "M30 · Supply · 20/20 · P:4", text.align_top)
        f_z(294.4900, 294.2700, timestamp("GMT", 2026, 7, 22, 18, 0), color.rgb(244, 114, 182), 78, color.rgb(229, 72, 77), "M30 · Supply · 19/20 · P:4", text.align_top)
