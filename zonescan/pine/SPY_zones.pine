//@version=6
// TP Fable Scanner — qualified zone overlay (build v57.3, run )
// Generated by the zone audit. Paste once into the Pine editor, save,
// add to chart: the correct zones appear per ticker automatically.
// Fill = timeframe: Monthly orange / Weekly yellow / Daily blue.
// Border = zone kind: green Demand / red Supply.
// Label: frame · core score/20 · P:purity subscore.
indicator("TP Fable Zones v57.3", overlay = true, max_boxes_count = 500)

f_z(_top, _bot, _left, _col, _transp, _kind_col, _txt, _valign) =>
    box.new(left = _left, right = time, top = _top, bottom = _bot,
         xloc = xloc.bar_time, extend = extend.right,
         border_color = _kind_col, border_width = 2,
         bgcolor = color.new(_col, _transp),
         text = _txt, text_color = _col, text_size = size.small,
         text_halign = text.align_right, text_valign = _valign)

var bool _drawn = false
if barstate.islast and not _drawn
    _drawn := true
    if syminfo.ticker == "SPY"
        f_z(482.8800, 466.4300, timestamp(2024, 1, 2), color.rgb(249, 115, 22), 90, color.rgb(47, 191, 113), "M · Demand · 18/20 · P:2", text.align_bottom)
        f_z(417.8500, 403.7400, timestamp(2023, 5, 1), color.rgb(249, 115, 22), 90, color.rgb(47, 191, 113), "M · Demand · 16/20 · P:0", text.align_bottom)
        f_z(564.3400, 556.0400, timestamp(2025, 5, 5), color.rgb(250, 204, 21), 87, color.rgb(47, 191, 113), "W · Demand · 19/20 · P:4", text.align_bottom)
        f_z(720.6500, 708.3700, timestamp(2026, 4, 27), color.rgb(250, 204, 21), 87, color.rgb(47, 191, 113), "W · Demand · 16/20 · P:2", text.align_bottom)
    if syminfo.ticker == "SPY"
        f_z(711.8150, 708.3700, timestamp(2026, 4, 28), color.rgb(59, 130, 246), 84, color.rgb(47, 191, 113), "D · Demand · 19/20 · P:4", text.align_bottom)
        f_z(701.6600, 698.5300, timestamp(2026, 4, 16), color.rgb(59, 130, 246), 84, color.rgb(47, 191, 113), "D · Demand · 19/20 · P:4", text.align_bottom)
        f_z(749.0600, 747.8000, timestamp("GMT", 2026, 7, 22, 18, 30), color.rgb(34, 211, 238), 82, color.rgb(229, 72, 77), "H4 · Supply · 20/20 · P:4", text.align_top)
        f_z(751.0400, 750.1100, timestamp("GMT", 2026, 7, 16, 18, 30), color.rgb(34, 211, 238), 82, color.rgb(229, 72, 77), "H4 · Supply · 18/20 · P:4", text.align_top)
    if syminfo.ticker == "SPY"
        f_z(750.0200, 749.4200, timestamp("GMT", 2026, 7, 22, 15, 30), color.rgb(167, 139, 250), 80, color.rgb(229, 72, 77), "H1 · Supply · 20/20 · P:4", text.align_top)
        f_z(743.7200, 742.6000, timestamp("GMT", 2026, 7, 24, 15, 30), color.rgb(167, 139, 250), 80, color.rgb(229, 72, 77), "H1 · Supply · 17/20 · P:4", text.align_top)
        f_z(741.8400, 741.4700, timestamp("GMT", 2026, 7, 24, 17, 0), color.rgb(244, 114, 182), 78, color.rgb(229, 72, 77), "M30 · Supply · 17/20 · P:4", text.align_top)
        f_z(743.7200, 743.0400, timestamp("GMT", 2026, 7, 24, 16, 0), color.rgb(244, 114, 182), 78, color.rgb(229, 72, 77), "M30 · Supply · 17/20 · P:4", text.align_top)
